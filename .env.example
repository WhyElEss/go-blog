# Copy to .env next to docker-compose.yml and fill in. Never commit .env.
# Read with `format: raw`: write values as-is, without quotes.

# Host port (LAN, and what the Cloudflare tunnel points at). Compose
# substitutes it, so it may stay unset.
HOST_PORT=8096
TZ=America/Toronto

# Admin password hash (required). Generate it with:
#   docker compose run --rm -it blog hashpw
ADMIN_PASSWORD_HASH=

# Public origin, without a trailing slash: absolute links in RSS and link
# previews, and an accepted Origin of form posts.
BASE_URL=

# Read the client IP from Cloudflare's CF-Connecting-IP header (login rate
# limit). Set to false when the blog is reached without Cloudflare.
TRUST_PROXY_HEADERS=true

# Bluesky account that announces new posts (optional). Create an app
# password in Bluesky's settings; never use the account password here.
# BLUESKY_SERVICE is the account's server, https://bsky.social by default.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE=
